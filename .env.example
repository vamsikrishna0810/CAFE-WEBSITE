# Local API origin used by the frontend when an API client is introduced.
VITE_CAFE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Local backend defaults. Configure real production values outside source control.
APP_ENV=development
DATABASE_URL=sqlite:///./cafe.db
CAFE_TIMEZONE=Asia/Kolkata
CAFE_CURRENCY=INR
